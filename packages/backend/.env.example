# Backend env. Copy to .env.local (gitignored) for local dev, and set the
# same vars on the VPS (e.g. an EnvironmentFile for the systemd unit).
# NEVER commit real secrets.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
# Public origin of the deployed site. REQUIRED in production: it scopes CORS,
# is used to build email + OAuth callback links, and switches session cookies
# to Secure. Leave UNSET in local dev (http://localhost via the Vite proxy).
PUBLIC_ORIGIN=https://personifyads.online

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgres://advert:CHANGE_ME@localhost:5432/advert

# ── Web sessions (email/password + Google) ────────────────────────────────────
# 32+ byte random string signing the short-lived OAuth state/PKCE cookies.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_COOKIE_SECRET=replace-with-a-strong-random-secret-at-least-32-bytes
# Web session lifetime (seconds). Default 30 days.
SESSION_TTL_SECONDS=2592000

# ── Google OAuth (Sign in with Google) ────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://personifyads.online/api/auth/google/callback

# ── Email — verification + password-reset links ───────────────────────────────
# The sender is auto-selected: SMTP if SMTP_HOST is set, else Resend if
# RESEND_API_KEY is set, else (dev) the link is logged to the console.
# From-address for either path (use a mailbox on your sending domain):
EMAIL_FROM=PersonifyAds <noreply@personifyads.online>
#
# Option A — SMTP (e.g. Titan, which you've set up on personifyads.online).
# Create the noreply@ mailbox in Titan and use its credentials. Port 465 = SSL.
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=noreply@personifyads.online
SMTP_PASS=
#
# Option B — Resend (leave SMTP_HOST blank to use this). Requires a
# Resend-verified sending domain.
RESEND_API_KEY=

# ── Legacy shared-credential login (Android app, Bearer JWT) — keep ───────────
AUTH_USERNAME=set-a-random-username-in-env-local
AUTH_PASSWORD=set-a-long-random-secret-in-env-local
# 32+ byte secret signing the Android Bearer JWTs.
AUTH_JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-bytes
AUTH_TOKEN_TTL_SECONDS=43200

# ── Provider API keys (server-held; web + Android never see these) ────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FAL_API_KEY=
ELEVENLABS_API_KEY=

# Soft per-user cost cap (USD). Server tracks cumulative spend and rejects
# calls that would exceed this. 0 disables.
SESSION_COST_CAP_USD=20

# ── Crypto payments (non-custodial tier upgrades) ─────────────────────────────
# Users buy Pro/Ultra by paying on-chain FROM THEIR OWN WALLET, then pasting the
# transaction hash; the backend verifies it on-chain and grants the tier. Funds
# go straight to the receiving addresses below — there is no processor and the
# server never holds keys or funds. A coin is only offered if its chain's
# receiving address is set here; leave an address blank to disable that chain.
#
# Tier prices (USD). Default to the plan-card copy ($19 / $49).
PRICE_PRO_USD=19
PRICE_ULTRA_USD=49
# How long a quote (and its locked token amount) stays valid, in minutes.
PAY_ORDER_TTL_MIN=30
#
# Receiving addresses (YOUR wallets — public addresses, but keep them here so
# they're easy to rotate and out of git). One EVM address serves Ethereum,
# Arbitrum and BNB Smart Chain.
PAY_EVM_ADDRESS=
PAY_BTC_ADDRESS=
PAY_SOL_ADDRESS=
#
# Confirmations required before a payment counts (higher = safer vs. reorgs).
PAY_ETH_MIN_CONF=3
PAY_ARBITRUM_MIN_CONF=5
PAY_BNB_MIN_CONF=6
PAY_BTC_MIN_CONF=1
#
# RPC / explorer endpoints. Sensible public defaults are built in; override with
# your own (e.g. an Alchemy/Infura/QuickNode URL) for reliability / rate limits.
# ETH_RPC_URL=https://eth.llamarpc.com
# ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# BNB_RPC_URL=https://bsc-dataseed.binance.org
# BTC_EXPLORER_URL=https://blockstream.info/api
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional price source override (CoinGecko-compatible).
# COINGECKO_API_BASE=https://api.coingecko.com/api/v3
